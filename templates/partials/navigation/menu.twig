{% if menu %}
    <ul class="navigation__list">
        {% for item in menu.get_items %}
            <li class="navigation__item">
                {% set has_children = item.children %}
                {% if has_children %}
                    <p-openable class="navigation__button" label="{{ item.title}}" :close-on-blur="false">
                    <div class="navigation__dropdown dropdown">
                        <ul class"dropdown__list">
                            {% for child in item.children %}
                                <li class="dropdown__item">
                                    <a href="{{ child.link }}" class="dropdown__link">{{ child.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    </p-openable>
                {% else %}
                    <a href="{{ item.link }}" class="navigation__link">{{ item.title }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
