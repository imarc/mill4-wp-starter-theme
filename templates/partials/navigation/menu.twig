{% if menu %}
    <nav class="navigation">
        <ul class="navigation__list">
            {% for item in menu.get_items %}
                <li class="navigation__item" v-directionals>
                    {% set has_children = item.children %}
                    {% if has_children %}
                        <bp-openable class="navigation__button" label="{{ item.title }}" :close-on-blur="false">
                            <div class="navigation__dropdown">
                                <ul>
                                    {% for child in item.children %}
                                        {% include "partials/navigation/item.twig" with {'item': child} %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </bp-openable>
                    {% else %}
                        {% include "partials/navigation/item.twig" with {'item': item} %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endif %}
