{% if menu %}
    <ul class="o-header__nav-list">
        {% for item in menu.get_items %}
            <li class="o-header__nav-item-wrapper">
                {% set has_children = item.children %}
                {% if has_children %}
                    <div class="o-header__nav-dropdown">
                        <a href="{{ item.link }}" class="o-header__nav-item">{{ item.title }}</a>
                        <ul class="o-header__nav-dropdown-list">
                            {% for child in item.children %}
                                <li class="o-header__nav-dropdown-item">
                                    <a href="{{ child.link }}" class="o-header__nav-item">{{ child.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ item.link }}" class="o-header__nav-item">{{ item.title }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
