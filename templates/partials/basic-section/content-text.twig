<div class="basicSection__text">
    <h3>{{ section.heading }}</h3>
    <p>{{ section.content }}</p>
    {% if section.links %}
        <div class="actions">
            {% for cta in section.links %}
                <a class="button -{{ cta.style }}" href="{{ cta.link.url }}">{{ cta.link.title }}</a>
            {% endfor %}
        </div>
    {% endif %}
</div>
