<div class="o-feature-cards">
    <div class="o-feature-cards__container">
        <h2 class="o-feature-cards__title">{{ block.title }}</h2>

        <div class="o-feature-cards__cards">
            {% for card in block.cards %}
                <div class="o-feature-cards__card">
                    {% if card.image %}
                        <img src="{{ card.image.url }}" alt="{{ card.image.alt }}" class="o-feature-cards__card-image">
                    {% endif %}
                    <div class="o-feature-cards__card-content">
                        <h3 class="o-feature-cards__card-heading">{{ card.heading }}</h3>
                        <div class="o-feature-cards__card-description">{{ card.description }}</div>
                        {% if card.link %}
                            <a href="{{ card.link.url }}" class="o-feature-cards__card-link">{{ card.link.title }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>