<blockquote class="testimonial">
    <svg class="testimonial__icon icon accent-primary" role="presentation">
        <use href="/wp-content/themes/mill4/resources/images/main-icons-sprite.svg#quote" />
    </svg>
    <p class="testimonial__content">
        {{ block.quote }}
    </p>
    <footer class="testimonial__footer">
        {% if block.image %}
            <div class="testimonial__citationPhotoWrapper">
                <img src="{{ block.image.url }}" alt="{{ block.image.alt }}" class="testimonial__citationPhoto">
            </div>
        {% endif %}
        <cite class="testimonial__citation">
            {{ block.author_name }}
            <span class="testimonial__citationTitle">
                <span class="testimonial__citationTitle">
                    {{ block.author_title }}{% if block.author_company %}, 
                        <span class="testimonial__citationCompany">
                            {{ block.author_company }}
                        </span>
                    {% endif %}
                </span>
            </span>
        </cite>
    </footer>
</blockquote>
