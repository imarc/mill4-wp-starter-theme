<div class="o-testimonial">
    <div class="o-testimonial__quote">
        {{ block.quote }}
    </div>
    {% if block.image %}
        <div class="o-testimonial__image">
            <img src="{{ block.image.url }}" alt="{{ block.image.alt }}">
        </div>
    {% endif %}
    <div class="o-testimonial__author-name">
        {{ block.author_name }}
    </div>
    {% if block.author_title %}
        <div class="o-testimonial__author-title">
            {{ block.author_title }}
        </div>
    {% endif %}
    {% if block.author_company %}
        <div class="o-testimonial__author-company">
            {{ block.author_company }}
        </div>
    {% endif %}
    {% if block.cta %}
        <div class="o-testimonial__cta">
            <a href="{{ block.cta.url }}" class="a-button">{{ block.cta.title }}</a>
        </div>
    {% endif %}
</div>
