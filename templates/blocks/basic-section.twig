{# layout can be "wide" or "2-column" #}
{% set layout = block.layout %}
{% set sections = layout == 'wide' ? [block.primary_content] : [block.primary_content, block.secondary_content] %}

<div class="section container basicSection accent-{{ block.accent }}">
    {% if block.heading or block.sub_heading %}
        <header class="section__header">
            {% if block.sub_heading %}
                <h2 class="h6 accent-primary">{{ block.sub_heading }}</h2>
            {% endif %}
            {% if block.section__heading %}
                <h3>{{ block.section__heading }}</h3>
            {% endif %}
        </header>
    {% endif %}
    <div class="basicSection__content -center">
        {% for section in sections %}
            {% include "partials/basic-section/content-"~section.content_type~".twig" with {'section': section} %}
        {% endfor %}
    </div>
</div>

