<div class="o-hero">
    <div class="o-hero__content">
        <h1 class="o-hero__title">{{ block.title }}</h1>
        <div class="o-hero__text">
            {{ block.text }}
        </div>
        {% if block.links %}
            <div class="o-hero__actions">
                {% for cta in block.links %}
                    <a class="a-button {{ cta.type == 'secondary' ? '-styleOutline' : '' }}" href="{{ cta.link.url }}">{{ cta.link.title }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if block.image %}
        <div class="o-hero__image">
            <img src="{{ block.image.url }}" alt="{{ block.image.alt }}">
        </div>
    {% endif %}
</div>
