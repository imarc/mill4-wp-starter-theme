<div class="m-accordion">
    <div class="m-accordion__container">
        {% if block.title %}
            <h1>{{ block.title }}</h1>
        {% endif %}

        {% if block.panels %}
            {% for panel in block.panels %}
                {% include 'partials/accordion-panel.twig' with {
                    heading: panel.heading,
                    content: panel.content,
                } %}
            {% endfor %}
        {% endif %}
    </div>
</div>
