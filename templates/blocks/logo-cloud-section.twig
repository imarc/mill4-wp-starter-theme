<div class="logoCloud">
    <div class="logoCloud__logos">
        {% for logo in block.logos %}
            <div class="logoCloud__logo">
                {% if logo.link %}
                    <a href="{{ logo.link.url }}" target="{{ logo.link.target }}">
                {% endif %}
                <img class="logoCloud__img" alt="{{ logo.image.alt }}" src="{{ logo.image.url }}" />
                {% if logo.link %}
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>