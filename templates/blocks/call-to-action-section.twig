<div class="section container ctaSection accent-{{ block.accent_color }}">
    {% if block.background_image %}
        <div class="section__bg">
            <picture><img src="{{ block.background_image.url }}" alt="{{ block.background_image.alt }}"></picture>
        </div>
    {% endif %}
    <div class="section__header">
        <h2>{{ block.title }}</h2>
    </div>
    <div class="section__content">
        {{ block.content }}
    </div>
    <div class="section__footer">
        {% if block.links %}
            <div class="actions">
                {% for cta in block.links %}
                    <a class="button {{ cta.type == 'secondary' ? '-styleOutline' : '' }}" href="{{ cta.link.url }}">{{ cta.link.title }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>