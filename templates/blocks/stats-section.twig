
{% set has_callout = block.callout and block.callout.content %}

<div class="section stats container {{ has_callout ? '-withCallout' : ''}}">
    {% if block.callout %}
        <div class="stats__callout">
            {% if block.callout.content %}
                <div class="h3">{{ block.callout.content }}</div>
            {% endif %}
            <div class="actions">
            {% if block.callout.link %}
                <a href="{{ block.callout.link.url }}" class="button">{{ block.callout.link.title }}</a>
            {% endif %}
            </div>
        </div>
    {% endif %}
    <div class="stats__content">
        {% for stat in block.stats %}
            <div class="stats__stat">
                <div class="stats__value">{{ stat.value }}</div>
                <div class="stats__description">{{ stat.description }}</div>
            </div>
        {% endfor %}
    </div>
</div>